// 4. Main Game Logic
const GameEditor = ({ user, initialData, onBack, supabase }) => {
  const [size, setSize] = useState(initialData?.size || 6);
  const config = GRID_CONFIGS[size];
  const inputBuffer = useRef({ str: '', timeout: null });

  const createEmptyGrid = (s) => Array(s).fill().map(() => Array(s).fill(null).map(() => ({
    value: '',
    notes: [],
    isGiven: false,
    cageId: null,
    fillColor: '#ffffff',
    valueColor: '#4f46e5'
  })));

  // Parse JSON se vier do banco, ou usa padrão
  const parseGrid = (g) => typeof g === 'string' ? JSON.parse(g) : g;
  const parseCages = (c) => typeof c === 'string' ? JSON.parse(c) : c;

  const [grid, setGrid] = useState(initialData ? parseGrid(initialData.grid) : createEmptyGrid(6));
  const [cages, setCages] = useState(initialData ? parseCages(initialData.cages) : []);
  const [selectedCells, setSelectedCells] = useState([]);
  const [mode, setMode] = useState('edit'); 
  const [activeCell, setActiveCell] = useState(null);
  const [pencilMode, setPencilMode] = useState(false);
  const [paintMode, setPaintMode] = useState(false);
  const [tempSum, setTempSum] = useState('');
  
  const [brushColor, setBrushColor] = useState('#ffffff');
  const [numberBrushColor, setNumberBrushColor] = useState('#4f46e5');
  const [colorLabels, setColorLabels] = useState(PALETTE.map(p => p.label));

  // Saving State
  const [isSaveModalOpen, setIsSaveModalOpen] = useState(false);
  const [currentCode, setCurrentCode] = useState(initialData?.code || '');
  const [currentStatus, setCurrentStatus] = useState(initialData?.status || 'ongoing');

  const handleSave = async (code, status) => {
    if (!user || !supabase) return;
    try {
      const gameId = initialData?.id || crypto.randomUUID();
      const gameData = {
        id: gameId,
        user_id: user.id,
        code: parseInt(code),
        status,
        size,
        // CORREÇÃO: Enviando o objeto direto para colunas jsonb, não stringified
        grid: grid, 
        cages: cages,
        last_updated: new Date().toISOString(),
      };
      
      const { error } = await supabase
        .from('games')
        .upsert(gameData);
      
      if (error) throw error;
      
      setCurrentCode(code);
      setCurrentStatus(status);
      setIsSaveModalOpen(false);
      alert("Jogo salvo com sucesso!");
    } catch (e) {
      console.error("Erro ao salvar:", e);
      alert("Erro ao salvar o jogo: " + e.message);
    }
  };

  const deleteCage = (cageId) => {
    const newGrid = grid.map(row => row.map(cell => {
      if (cell.cageId === cageId) {
        return { ...cell, cageId: null };
      }
      return cell;
    }));
    setGrid(newGrid);
    setCages(cages.filter(c => c.id !== cageId));
  };

  const handleSizeChange = (newSize) => {
    setSize(newSize);
    setGrid(createEmptyGrid(newSize));
    setCages([]);
    setSelectedCells([]);
    setActiveCell(null);
    setTempSum('');
  };

  const handleCellClick = (r, c, e) => {
    e.stopPropagation(); 
    if (mode === 'edit') {
      const isSelected = selectedCells.find(cell => cell.r === r && cell.c === c);
      if (isSelected) {
        setSelectedCells(selectedCells.filter(cell => !(cell.r === r && cell.c === c)));
      } else {
        setSelectedCells([...selectedCells, { r, c }]);
      }
    } else {
      if (paintMode) {
        const newGrid = grid.map(row => row.map(cell => ({ ...cell })));
        newGrid[r][c].fillColor = brushColor;
        setGrid(newGrid);
      }
      setActiveCell({ r, c });
    }
  };

  const handleInput = useCallback((num) => {
    if (!activeCell) return;
    const { r, c } = activeCell;
    const validNums = Array.from({ length: size }, (_, i) => (i + 1).toString());
    
    if (validNums.includes(num)) {
      const newGrid = grid.map(row => row.map(cell => ({ ...cell })));
      if (mode === 'edit') {
        newGrid[r][c].value = num;
        newGrid[r][c].isGiven = true;
        newGrid[r][c].valueColor = '#000000';
      } else {
        if (!newGrid[r][c].isGiven) {
          if (pencilMode) {
            const currentNotes = newGrid[r][c].notes;
            newGrid[r][c].notes = currentNotes.includes(num) 
              ? currentNotes.filter(n => n !== num) 
              : [...currentNotes, num].sort((a,b) => parseInt(a)-parseInt(b));
          } else {
            newGrid[r][c].value = newGrid[r][c].value === num ? '' : num;
            newGrid[r][c].valueColor = numberBrushColor;
            newGrid[r][c].notes = [];
          }
        }
      }
      setGrid(newGrid);
    } else if (num === 'Backspace' || num === 'Delete') {
      const newGrid = grid.map(row => row.map(cell => ({ ...cell })));
      if (mode === 'edit' || !newGrid[r][c].isGiven) {
        newGrid[r][c].value = '';
        newGrid[r][c].notes = [];
        if (mode === 'edit') newGrid[r][c].isGiven = false;
      }
      setGrid(newGrid);
    }
  }, [activeCell, grid, mode, pencilMode, size, numberBrushColor]);

  // UseEffect for inputs
  useEffect(() => {
    const onKeyDown = (e) => {
      if (e.key === 'Backspace' || e.key === 'Delete') {
        handleInput(e.key);
        return;
      }
      if (e.key >= '0' && e.key <= '9') {
        if (size <= 9) {
          handleInput(e.key);
        } else {
          const num = e.key;
          if (inputBuffer.current.timeout) clearTimeout(inputBuffer.current.timeout);
          inputBuffer.current.str += num;
          const processBuffer = () => {
            const val = inputBuffer.current.str;
            const intVal = parseInt(val);
            if (intVal > 0 && intVal <= size) {
               handleInput(val);
            } else {
               if (val.length === 1 && intVal > 0) handleInput(val);
            }
            inputBuffer.current.str = '';
            inputBuffer.current.timeout = null;
          };
          inputBuffer.current.timeout = setTimeout(processBuffer, 250);
        }
      }
    };
    window.addEventListener('keydown', onKeyDown);
    return () => window.removeEventListener('keydown', onKeyDown);
  }, [handleInput, size]);

  const getBorderStyle = (r, c) => {
    const cell = grid[r][c];
    const isSameCage = (nr, nc) => {
      if (nr < 0 || nr >= size || nc < 0 || nc >= size) return false;
      return grid[nr][nc].cageId === cell.cageId;
    };
    const baseBorder = '1px solid #cbd5e1'; 
    const cageBorder = '2.5px dashed #1e293b'; 

    return {
      borderTop: (cell.cageId && !isSameCage(r - 1, c)) ? cageBorder : baseBorder,
      borderBottom: (cell.cageId && !isSameCage(r + 1, c)) ? cageBorder : baseBorder,
      borderLeft: (cell.cageId && !isSameCage(r, c - 1)) ? cageBorder : baseBorder,
      borderRight: (cell.cageId && !isSameCage(r, c + 1)) ? cageBorder : baseBorder,
    };
  };

  const getCageLabel = (r, c) => {
    const cage = cages.find(cg => cg.id === grid[r][c].cageId);
    if (!cage) return null;
    const sortedCells = [...cage.cells].sort((a, b) => a.r !== b.r ? a.r - b.r : a.c - b.c);
    if (sortedCells[0].r === r && sortedCells[0].c === c) return cage.sum;
    return null;
  };

  const isHighlighted = (r, c) => {
    if (!activeCell) return false;
    const { r: ar, c: ac } = activeCell;
    if (r === ar || c === ac) return true;
    const br = Math.floor(r / config.rows);
    const bc = Math.floor(c / config.cols);
    const abr = Math.floor(ar / config.rows);
    const abc = Math.floor(ac / config.cols);
    return br === abr && bc === abc;
  };

  const getCellSizeClass = () => {
    if (size === 6) return 'w-16 h-16 sm:w-24 sm:h-24 text-3xl sm:text-5xl';
    if (size === 9) return 'w-10 h-10 sm:w-16 sm:h-16 text-xl sm:text-3xl';
    if (size === 12) return 'w-8 h-8 sm:w-12 sm:h-12 text-lg sm:text-2xl';
    return 'w-6 h-6 sm:w-10 sm:h-10 text-xs sm:text-lg';
  };

  const getNoteSizeClass = () => {
    if (size === 6) return 'text-[10px] sm:text-[14px]';
    if (size === 9) return 'text-[9px] sm:text-[13px]'; 
    if (size === 12) return 'text-[7px] sm:text-[10px]';
    return 'text-[6px] sm:text-[9px]';
  };

  const getNoteGridClass = () => {
    if (size === 6) return 'grid-cols-3 grid-rows-2'; 
    if (size === 9) return 'grid-cols-3 grid-rows-3'; 
    if (size === 12) return 'grid-cols-4 grid-rows-3'; 
    if (size === 16) return 'grid-cols-4 grid-rows-4'; 
    return 'grid-cols-3';
  };

  const updateColorLabel = (index, value) => {
    const newLabels = [...colorLabels];
    newLabels[index] = value;
    setColorLabels(newLabels);
  };

  return (
    <div className="min-h-screen bg-slate-100 flex flex-col items-center p-4 md:p-8 font-sans text-slate-800" onClick={(e) => { if(e.target.dataset.background) setActiveCell(null); }} data-background="true">
      <header className="max-w-6xl w-full flex flex-col xl:flex-row justify-between items-center mb-8 gap-6" data-background="true">
        <div className="flex flex-col md:flex-row items-center gap-6">
          <button onClick={onBack} className="p-3 bg-white rounded-xl text-slate-400 hover:text-slate-800 transition-colors shadow-sm">
            <ArrowLeft size={20} />
          </button>
          <div className="text-center md:text-left">
            <h1 className="text-3xl font-black text-slate-900 tracking-tighter italic leading-none">Editor <span className="text-indigo-600">Sudoku</span></h1>
            <p className="text-slate-500 font-bold uppercase text-[10px] tracking-[0.2em] mt-2">
              {currentCode ? `Código #${currentCode} • ${currentStatus === 'finished' ? 'Finalizado' : 'Em Andamento'}` : 'Jogo não salvo'}
            </p>
          </div>
          
          <div className="flex bg-white rounded-2xl shadow-sm border border-slate-200 p-1">
            {[6, 9, 12, 16].map(s => (
              <button 
                key={s}
                onClick={() => handleSizeChange(s)}
                className={`px-5 py-2.5 rounded-xl text-sm font-black transition-all ${size === s ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-100' : 'text-slate-400 hover:bg-slate-50 hover:text-slate-600'}`}
              >
                {s}x{s}
              </button>
            ))}
          </div>
        </div>
        
        <div className="flex gap-2">
          <div className="flex bg-white p-1.5 rounded-2xl shadow-sm border border-slate-200">
            <button 
              onClick={() => { setMode('edit'); setActiveCell(null); setPaintMode(false); }}
              className={`flex items-center gap-2 px-5 py-3 rounded-xl font-black transition-all ${mode === 'edit' ? 'bg-blue-600 text-white shadow-lg shadow-blue-100' : 'text-slate-400 hover:bg-slate-50'}`}
            >
              <Edit2 size={18} /> Configurar
            </button>
            <button 
              onClick={() => { setMode('play'); setSelectedCells([]); setActiveCell(null); }}
              className={`flex items-center gap-2 px-5 py-3 rounded-xl font-black transition-all ${mode === 'play' ? 'bg-green-600 text-white shadow-lg shadow-green-100' : 'text-slate-400 hover:bg-slate-50'}`}
            >
              <Play size={18} /> Jogar
            </button>
          </div>

          <button 
            onClick={() => setIsSaveModalOpen(true)}
            className="flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white rounded-2xl font-black hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200"
          >
            <Save size={20} /> Salvar
          </button>
        </div>
      </header>

      <main className="max-w-[1400px] w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-background="true">
        {/* Painel Esquerdo (Tools) */}
        <div className="lg:col-span-3 space-y-4 order-2 lg:order-1">
          {mode === 'edit' ? (
            <div className="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 sticky top-4">
              <h2 className="text-lg font-black mb-4 text-slate-800 flex items-center gap-2 italic">
                <Plus size={22} className="text-blue-500" /> Nova Gaiola
              </h2>
              {selectedCells.length > 0 ? (
                <div className="space-y-4 animate-in fade-in zoom-in-95 duration-200">
                  <div className="bg-blue-50 p-4 rounded-2xl border border-blue-100 text-center">
                    <span className="text-2xl font-black text-blue-600">{selectedCells.length}</span>
                    <p className="text-[10px] font-bold text-blue-400 uppercase tracking-widest">Células Selecionadas</p>
                  </div>
                  <input 
                    type="number"
                    value={tempSum}
                    onChange={(e) => setTempSum(e.target.value)}
                    placeholder="SOMA"
                    className="w-full p-4 bg-slate-50 border-2 border-slate-100 rounded-2xl focus:border-blue-500 focus:outline-none font-black text-3xl text-center"
                  />
                  <div className="flex gap-2">
                    <button 
                      onClick={() => {
                        const hasOverlap = selectedCells.some(cell => grid[cell.r][cell.c].cageId !== null);
                        if (!hasOverlap) {
                          const id = Date.now().toString();
                          const sumVal = parseInt(tempSum);
                          const newCage = { id, sum: sumVal, cells: [...selectedCells], color: `hsl(${Math.random() * 360}, 75%, 95%)` };
                          const newGrid = grid.map(row => row.map(cell => ({ ...cell })));
                          selectedCells.forEach(({r, c}) => { newGrid[r][c].cageId = id; });
                          setCages([...cages, newCage]);
                          setGrid(newGrid);
                          setSelectedCells([]);
                          setTempSum('');
                        }
                      }}
                      disabled={!tempSum}
                      className="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-black hover:bg-blue-700 disabled:opacity-50 transition-all shadow-xl shadow-blue-100"
                    >
                      Confirmar
                    </button>
                    <button onClick={() => {setSelectedCells([]); setTempSum('');}} className="px-4 bg-slate-100 text-slate-400 rounded-2xl hover:bg-slate-200">
                      <X size={20} />
                    </button>
                  </div>
                </div>
              ) : (
                <div className="text-center py-10 px-4 border-2 border-dashed border-slate-100 rounded-3xl">
                  <p className="text-sm text-slate-400 font-bold leading-relaxed">Clique nas células para as agrupar.</p>
                </div>
              )}
              {cages.length > 0 && (
                <div className="mt-8 pt-6 border-t border-slate-100">
                  <h3 className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-4">Gaiolas Criadas ({cages.length})</h3>
                  <div className="space-y-2 max-h-[300px] overflow-y-auto custom-scrollbar pr-1">
                    {[...cages].reverse().map(cage => (
                      <div key={cage.id} className="flex items-center justify-between p-2 bg-slate-50 rounded-xl border border-slate-100 group hover:border-blue-200 transition-colors">
                        <div className="flex items-center gap-3">
                          <div className="w-10 h-10 rounded-lg flex items-center justify-center font-black text-slate-700 shadow-sm" style={{backgroundColor: cage.color}}>
                            {cage.sum}
                          </div>
                          <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wide">{cage.cells.length} células</span>
                        </div>
                        <button 
                          onClick={() => deleteCage(cage.id)}
                          className="p-2 text-slate-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                        >
                          <Trash2 size={18} />
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ) : (
             <div className="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 space-y-6">
              <div>
                <h2 className="text-sm font-black text-slate-800 mb-3 flex items-center gap-2 uppercase tracking-widest">
                  <Palette size={16} className="text-indigo-500" /> Legenda de Cores
                </h2>
                <div className="space-y-3">
                  {PALETTE.map((p, i) => (
                    <div key={i} className="flex items-center gap-2">
                      <button 
                        onClick={() => { setBrushColor(p.color); setPaintMode(true); }}
                        className={`w-8 h-8 rounded-lg border-2 transition-all ${brushColor === p.color && paintMode ? 'border-indigo-600 scale-110 shadow-md' : 'border-slate-100 hover:scale-105'}`}
                        style={{ backgroundColor: p.color }}
                      />
                      <input 
                        type="text" 
                        placeholder="Nota..."
                        value={colorLabels[i]}
                        onChange={(e) => updateColorLabel(i, e.target.value)}
                        className="flex-1 bg-slate-50 border-none text-[11px] font-bold p-1 rounded focus:bg-white focus:ring-1 focus:ring-indigo-100"
                      />
                    </div>
                  ))}
                  <button 
                    onClick={() => setPaintMode(!paintMode)}
                    className={`w-full py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all border-2 ${paintMode ? 'bg-indigo-600 text-white border-indigo-600 shadow-lg' : 'bg-white text-slate-400 border-slate-100 shadow-sm'}`}
                  >
                    {paintMode ? 'Modo Pintura Ativo' : 'Ativar Pintura'}
                  </button>
                </div>
              </div>

              {/* RESTAURADO: Seletor de Cores dos Números */}
              <div className="pt-4 border-t border-slate-100">
                <h2 className="text-sm font-black text-slate-800 mb-3 flex items-center gap-2 uppercase tracking-widest">
                  <Type size={16} className="text-indigo-500" /> Cor do Número
                </h2>
                <div className="flex gap-2 justify-between">
                  {NUMBER_COLORS.map((nc, i) => (
                    <button 
                      key={i}
                      onClick={() => setNumberBrushColor(nc.color)}
                      className={`flex-1 h-8 rounded-lg border-2 flex items-center justify-center transition-all ${numberBrushColor === nc.color ? 'border-indigo-600 scale-110 shadow-sm' : 'border-slate-100 hover:bg-slate-50 shadow-sm'}`}
                      title={nc.label}
                    >
                      <div className="w-4 h-4 rounded-full" style={{ backgroundColor: nc.color }} />
                    </button>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>

        {/* Tabuleiro */}
        <div className="lg:col-span-6 flex flex-col items-center order-1 lg:order-2 overflow-x-auto w-full pb-8" data-background="true">
          <div className="relative bg-slate-900 p-1.5 rounded-2xl shadow-2xl border-[4px] border-slate-900 ring-4 ring-white">
            <div 
              className="grid bg-slate-300 gap-0" 
              style={{ 
                gridTemplateColumns: `repeat(${size}, min-content)`,
                width: 'fit-content'
              }}
            >
              {grid.map((row, r) => row.map((cell, c) => {
                const isSelected = selectedCells.some(sc => sc.r === r && sc.c === c);
                const isActive = activeCell?.r === r && activeCell?.c === c;
                const highlighted = isHighlighted(r, c);
                const cage = cages.find(cg => cg.id === cell.cageId);
                const isRightEdgeBlock = (c + 1) % config.cols === 0 && c !== size - 1;
                const isBottomEdgeBlock = (r + 1) % config.rows === 0 && r !== size - 1;
                const borders = getBorderStyle(r, c);
                let baseBg = cell.fillColor;
                if (isSelected) baseBg = '#dbeafe'; 
                else if (isActive) baseBg = '#f1f5f9'; 
                else if (highlighted && activeCell) {
                  baseBg = `color-mix(in srgb, ${cell.fillColor} 80%, #6366f1 20%)`;
                } else if (cage) {
                  if (cell.fillColor === '#ffffff') baseBg = cage.color;
                }
                return (
                  <div 
                    key={`${r}-${c}`}
                    onClick={(e) => handleCellClick(r, c, e)}
                    style={{ ...borders, backgroundColor: baseBg, borderRight: isRightEdgeBlock ? '5px solid #0f172a' : borders.borderRight, borderBottom: isBottomEdgeBlock ? '5px solid #0f172a' : borders.borderBottom }}
                    className={`relative flex items-center justify-center cursor-pointer select-none transition-all duration-75 font-black shrink-0 ${getCellSizeClass()} ${isActive ? 'z-20 scale-105 shadow-2xl ring-2 ring-indigo-500' : 'z-10'} ${isSelected ? 'ring-2 ring-blue-500 ring-inset' : ''}`}
                  >
                    {highlighted && activeCell && !isActive && (<div className="absolute inset-0 bg-indigo-500/20 pointer-events-none" />)}
                    <span className="absolute top-0.5 left-1 text-[7px] sm:text-[11px] font-black text-slate-600 leading-none pointer-events-none uppercase">{getCageLabel(r, c)}</span>
                    <span style={{ color: cell.valueColor }} className="drop-shadow-sm transition-colors duration-200">{cell.value}</span>
                    {cell.value === '' && cell.notes.length > 0 && (
                      <div className={`absolute inset-0.5 grid ${getNoteGridClass()} gap-0.5 pointer-events-none h-full w-full content-center`}>
                        {Array.from({length: size}).map((_, i) => {
                          const noteNum = (i + 1).toString();
                          const isPresent = cell.notes.includes(noteNum);
                          return (<div key={i} className={`${getNoteSizeClass()} font-black flex items-center justify-center leading-none ${isPresent ? 'text-slate-900' : 'text-transparent'}`}>{isPresent ? noteNum : ''}</div>);
                        })}
                      </div>
                    )}
                  </div>
                );
              }))}
            </div>
          </div>
          <div className="mt-8 flex gap-4" data-background="true">
            {mode === 'play' && (
              <button 
                onClick={() => setPencilMode(!pencilMode)}
                className={`flex items-center gap-3 px-10 py-4 rounded-2xl font-black transition-all shadow-lg active:scale-95 ${pencilMode ? 'bg-amber-500 text-white shadow-amber-200' : 'bg-white text-slate-600 border-2 border-slate-200 shadow-sm'}`}
              >
                <Hash size={20} /> NOTAS: {pencilMode ? 'LIGADO' : 'DESLIGADO'}
              </button>
            )}
            <button onClick={() => { if(confirm("Limpar tabuleiro?")) setGrid(createEmptyGrid(size)); }} className="px-8 py-4 bg-white text-slate-300 border-2 border-slate-100 rounded-2xl font-black hover:text-red-500 transition-all active:scale-95 shadow-sm">
              <RotateCcw size={22} />
            </button>
          </div>
        </div>

        {/* Teclado */}
        <div className="lg:col-span-3 space-y-4 order-3">
          <div className="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
             <h2 className="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-4 text-center">Entrada Numérica</h2>
            <div className={`grid ${size > 9 ? 'grid-cols-4' : 'grid-cols-3'} gap-3`}>
              {Array.from({ length: size }).map((_, i) => {
                const n = (i + 1).toString();
                return <button key={n} onClick={() => handleInput(n)} className="h-14 flex items-center justify-center bg-slate-50 hover:bg-indigo-600 hover:text-white rounded-2xl text-xl font-black text-slate-700 border border-slate-100 transition-all active:scale-90 shadow-sm">{n}</button>;
              })}
              <button onClick={() => handleInput('Backspace')} className="col-span-full h-14 bg-slate-100 text-slate-400 rounded-2xl font-black text-xs uppercase tracking-widest mt-2 hover:bg-slate-200 hover:text-slate-600 transition-all">Limpar Célula</button>
            </div>
          </div>
        </div>
      </main>
      
      <SaveModal 
        isOpen={isSaveModalOpen} 
        onClose={() => setIsSaveModalOpen(false)} 
        onSave={handleSave} 
        currentCode={currentCode}
        currentStatus={currentStatus}
      />

      <style>{`
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
      `}</style>
    </div>
  );
};

// --- Main App Controller ---
const App = () => {
  const [supabase, setSupabase] = useState(null);
  const [isSupabaseReady, setIsSupabaseReady] = useState(false);
  const [user, setUser] = useState(null);
  const [view, setView] = useState('auth'); // 'auth', 'dashboard', 'editor'
  const [activeGame, setActiveGame] = useState(null);

  // 1. Injeta o Script do Supabase no <head>
  useEffect(() => {
    if (window.supabase) {
      setSupabase(window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY));
      setIsSupabaseReady(true);
      return;
    }

    const script = document.createElement('script');
    script.src = "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2";
    script.async = true;
    script.onload = () => {
      // Quando carregar, inicializa o cliente
      if (window.supabase) {
        const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        setSupabase(client);
        setIsSupabaseReady(true);
      }
    };
    document.body.appendChild(script);
  }, []);

  // 2. Configura o Listener de Auth assim que o Supabase estiver pronto
  useEffect(() => {
    if (!supabase) return;

    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {
      if (session?.user) {
        setUser(session.user);
        setView('dashboard');
      } else {
        setUser(null);
        setView('auth');
      }
    });

    return () => subscription.unsubscribe();
  }, [supabase]);

  const handleLogout = async () => {
    if(supabase) await supabase.auth.signOut();
    setView('auth');
  };

  const handleNewGame = () => {
    setActiveGame(null);
    setView('editor');
  };

  const handleLoadGame = (gameData) => {
    setActiveGame(gameData);
    setView('editor');
  };

  const handleBackToDashboard = () => {
    setView('dashboard');
    setActiveGame(null);
  };

  if (!isSupabaseReady) {
    return (
      <div className="min-h-screen bg-slate-900 flex items-center justify-center flex-col gap-4">
        <div className="w-10 h-10 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin"></div>
        <p className="text-white font-bold animate-pulse">Carregando sistema...</p>
      </div>
    );
  }

  if (view === 'auth') {
    return <AuthScreen onLogin={() => setView('dashboard')} supabase={supabase} />;
  }

  if (view === 'dashboard') {
    return <Dashboard user={user} onNewGame={handleNewGame} onLoadGame={handleLoadGame} onLogout={handleLogout} supabase={supabase} />;
  }

  return <GameEditor user={user} initialData={activeGame} onBack={handleBackToDashboard} supabase={supabase} />;
};

export default App;
